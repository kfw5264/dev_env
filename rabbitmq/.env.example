# ============================================================
# dev-rabbitmq 环境变量示例文件
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
# 对应 docker-compose.yml 中 ${VAR:-默认值} 的插值，缺省时使用默认值
# ============================================================

# 默认用户 / 密码 / 虚拟主机
# 仅首次初始化（rabbitmq_data 数据卷为空）时创建；
# 管理控制台 http://localhost:15672 使用同一账号登录
RABBITMQ_DEFAULT_USER=dev
RABBITMQ_DEFAULT_PASS=dev123
RABBITMQ_DEFAULT_VHOST=dev
