# ============================================================
# dev-mysql 环境变量示例文件
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
# 对应 docker-compose.yml 中 ${VAR:-默认值} 的插值，缺省时使用默认值
# ============================================================

# root 超级用户密码（首次初始化数据卷时生效）
MYSQL_ROOT_PASSWORD=root123

# 额外创建的开发用户 / 密码 / 数据库（首次初始化数据卷时生效）
# 提示：nacos 复用了本 MySQL，但用的是独立库 nacos_data 与账号 nacos_admin，
#       请在 nacos/.env 中维护那套凭据，与这里的 MYSQL_USER/MYSQL_PASSWORD 无关。
MYSQL_USER=dev
MYSQL_PASSWORD=dev123
MYSQL_DATABASE=dev
