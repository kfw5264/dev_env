# ============================================================
# dev-postgresql 环境变量示例文件
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
# 对应 docker-compose.yml 中 ${VAR:-默认值} 的插值，缺省时使用默认值
# ============================================================

# 超级用户 / 密码（首次初始化数据卷时生效）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# 默认数据库（首次初始化时创建，initdb 扩展脚本作用于该库）
POSTGRES_DB=dev
