# ============================================================
# dev-nacos 环境变量示例文件
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
# 对应 docker-compose.yml 中 ${VAR:-默认值} 的插值，缺省时使用默认值；
# 其中 NACOS_AUTH_TOKEN / NACOS_AUTH_IDENTITY_* 为必填（:? 语法），未设置会启动失败
# ============================================================

# Nacos 连接 MySQL（mysql 栈）时使用的账号密码 —— 这是 nacos 专用库
# nacos_data 的账号（需预先在 MySQL 中创建，见根目录 README），
# 与 mysql/.env 中 MYSQL_PASSWORD（dev 用户）是两套凭据，请勿混用。
MYSQL_PASSWORD=Nacos_123

# 是否开启 Nacos 鉴权（关闭则无需下面三个变量，但控制台/API 无鉴权，仅限纯本地调试）
NACOS_AUTH_ENABLE=true

# ---- 鉴权密钥（必填）----
# 下面为随机构造的可用示例值（base64，解码后 48 字节 >= 32 字节要求）。
# 正式使用前建议重新生成，命令：openssl rand -base64 48
NACOS_AUTH_TOKEN=8zTOZlc0fpI9U09IAZg4IEZSc2tSfucERaH8caByAQ5gJbsTgCsxnpHSxse9KT4m

# 服务间鉴权身份（key/value 自行定义、服务端与客户端保持一致即可）。
# 建议重新生成 value：openssl rand -hex 24
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=04e649c743b17da31ca104c9d7f07cff714ce156ed9ee8e3
