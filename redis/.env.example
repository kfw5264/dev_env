# ============================================================
# dev-redis 环境变量示例文件
# 用法：复制为 .env 后按需修改
#   cp .env.example .env
# 对应 docker-compose.yml 中 ${VAR:-默认值} 的插值，缺省时使用默认值
# ============================================================

# 访问密码（compose 通过 --requirepass 注入容器，健康检查与 ./dev_env.sh cli 均读取）
REDIS_PASSWORD=redis123
